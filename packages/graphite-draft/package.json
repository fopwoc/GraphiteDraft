{
  "name": "graphite-draft",
  "version": "0.0.0-development",
  "description": "Turn a Markdown directory into a quiet static website.",
  "keywords": [
    "markdown",
    "static-site-generator",
    "cli",
    "github-action",
    "astro"
  ],
  "homepage": "https://github.com/fopwoc/GraphiteDraft#readme",
  "bugs": {
    "url": "https://github.com/fopwoc/GraphiteDraft/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fopwoc/GraphiteDraft.git"
  },
  "license": "WTFNMFPL",
  "author": "Ilya Dobryakov <https://github.com/fopwoc>",
  "type": "module",
  "bin": {
    "graphite-draft": "bin/graphite-draft.mjs"
  },
  "files": [
    "COPYRIGHT",
    "bin/",
    "scripts/build.mjs",
    "scripts/postprocess-output.mjs",
    "src/",
    "astro.config.mjs",
    "uno.config.ts",
    "tsconfig.json"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "bun run scripts/build.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test:smoke": "bun run scripts/smoke-test.ts",
    "test:cli": "bun run scripts/cli-test.ts",
    "test": "bun run check && bun run test:smoke && bun run test:cli"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.4",
    "@astrojs/mdx": "7.0.8",
    "@unocss/astro": "66.8.1",
    "astro": "7.2.9",
    "happy-dom": "20.11.12",
    "html-minifier-terser": "7.2.0",
    "isomorphic-mermaid": "0.1.1",
    "mermaid": "11.17.2",
    "sharp": "0.35.4",
    "unocss": "66.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "26.4.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "bun@1.4.0"
}
