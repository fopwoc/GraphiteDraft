{
  "name": "graphite-draft-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/graphite-draft build",
    "check": "bun run --cwd packages/graphite-draft check",
    "dev": "bun run --cwd packages/graphite-draft dev",
    "preview": "bun run --cwd packages/graphite-draft preview",
    "test": "bun run --cwd packages/graphite-draft test",
    "test:cli": "bun run --cwd packages/graphite-draft test:cli",
    "test:smoke": "bun run --cwd packages/graphite-draft test:smoke",
    "version:resolve": "node tools/resolve-version.mjs"
  },
  "packageManager": "bun@1.4.0"
}
