{
  "name": "graphite-draft",
  "version": "1.1.0",
  "description": "Turn a Markdown directory into a quiet static website.",
  "keywords": [
    "markdown",
    "static-site-generator",
    "cli",
    "github-action",
    "astro"
  ],
  "homepage": "https://github.com/fopwoc/GraphiteDraft#readme",
  "bugs": {
    "url": "https://github.com/fopwoc/GraphiteDraft/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fopwoc/GraphiteDraft.git"
  },
  "license": "WTFPL",
  "author": "Fopwoc",
  "type": "module",
  "main": "index.js",
  "bin": {
    "graphite-draft": "bin/graphite-draft.mjs"
  },
  "directories": {
    "example": "examples"
  },
  "files": [
    "bin/",
    "scripts/build.mjs",
    "scripts/copy-content-assets.mjs",
    "src/",
    "astro.config.mjs",
    "uno.config.ts",
    "tsconfig.json"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "bun run scripts/build.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test:smoke": "bun run scripts/smoke-test.ts",
    "test:cli": "bun run scripts/cli-test.ts",
    "test": "bun run check && bun run test:smoke && bun run test:cli",
    "prepublishOnly": "bun run test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.1",
    "@astrojs/mdx": "7.0.3",
    "@unocss/astro": "66.7.5",
    "astro": "7.1.3",
    "happy-dom": "20.11.0",
    "html-minifier-terser": "7.2.0",
    "isomorphic-mermaid": "0.1.1",
    "mermaid": "11.16.0",
    "unocss": "66.7.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@types/node": "26.1.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "bun@1.3.14"
}
